{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<section class="h-screen  flex items-center justify-center  gap-4">

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}
    <div class="flex flex-col gap-4 w-96  bg-white p-8 rounded-lg ">
        <h1 class=" font-regular mb-4 text-left">Gestion de Tâches</h1>

        {{ form_label(registrationForm.email) }}
        {{ form_widget(registrationForm.email) }}

        {{form_row(registrationForm.username)}}

        {{ form_row(registrationForm.plainPassword, {
        label: 'Password'
        }) }}
       
        <button type="submit" class="btn text-white bg-[#030213] rounded-lg p-2">S'incrire</button>
    </div>
    {{ form_end(registrationForm) }}
</section>
{% endblock %}