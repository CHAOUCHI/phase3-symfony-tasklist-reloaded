{% extends 'base.html.twig' %}

{% block title %}Connecté!{% endblock %}

{% block body %}
<section class="h-screen  flex items-center justify-center  gap-4">
    <form method="post">
        {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}


        <div class="flex flex-col gap-4 w-96 bg-white p-8 rounded-lg ">
            <h1 class="font-regular mb-4 text-left">Gestion de Tâches</h1>
            <p class="text-[#717182] text-sm mb-2">Organisez votre journée efficacement</p>
            <div class="w-full bg-[#F3F3F5] p-2 rounded-full flex flex-row"><a href="{{ path('app_login') }}"
                    class="btn  text-2xl text-center font-normal bg-transparent  hover:bg-white rounded-full p-2 w-50">Connexion</a>
                <a href="{{path('app_register')}}"
                    class="btn text-2xl text-center font-normal text-black bg-white hover:bg-white rounded-full p-2 w-50">Inscription</a>
            </div>
            <label for="username">Email</label>
            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control w-full bg-[#F3F3F5] p-2"
                autocomplete="email" required>
            <label for="password">Mot de passe</label>
            <input type="password" name="_password" id="password" class="form-control w-full bg-[#F3F3F5] p-2" autocomplete="current-password"
                required>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                value="{{ csrf_token('authenticate') }}">


            <button class="btn text-white bg-[#030213] hover:bg-white hover:text-black rounded-lg p-2" type="submit">
                Se connecter
            </button>
        </div>
    </form>
</section>


{% endblock %}