{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="h-full min-w-2 p-4 m-4 bg-white rounded-md flex flex-col justify-center">
    <h1 class="mb-2 ">Gestion des tâches</h1>
    <p class="text-gray-400 mb-1">Organisez votre journée efficacement</p>

    <div class="flex gap-16 justify-center rounded-md mb-2 bg-gray-100 p-2">
        <button type= "font-bold">Connexion</button>
        <button type= "submit">Inscription</button>
    </div>

    <div class="flex flex-col">
        {# Affichage de l'erreur si la connexion échoue #}
        {% if error %}
            <div class="bg-red-100 text-red-700 p-3 rounded mb-4">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {# FORMULAIRE HTML CLASSIQUE #}
        <form method="post">
            <div class="mb-4 block">
                <label for="inputEmail" class="block mb-1">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="w-full border p-2 bg-gray-100 rounded" placeholder="votre@email.com" autocomplete="email" required autofocus>
            </div>
                 
            <div class="mb-4 block">
                <label for="inputPassword" class="block mb-1">Password</label>
                <input type="password" name="_password" id="inputPassword" class="w-full border p-2 bg-gray-100 rounded" placeholder="..............." autocomplete="current-password" required>
            </div>

            {# Jeton de sécurité CSRF #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="w-full bg-black text-white p-2 rounded-md">Se connecter</button>
        </form>
    </div>
</div>
{% endblock %}